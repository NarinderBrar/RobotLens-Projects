    <joint name="left_wheel_joint" type="revolute">
      <parent>Autonomous_mobile_robot</parent>
      <child>left_wheel</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper><effort>30</effort></limit>
