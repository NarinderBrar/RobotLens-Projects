<?xml version="1.0"?>
<!--
  Breadboard Hobby Robot — Gazebo SDF 1.6 model
  Generic three-wheeled hobby differential-drive robot with rectangular chassis.
  Dimensions representative of a compact aluminium-style breadboard platform.

  Physical dimensions (metres):
    Chassis     : box 0.115 m (fwd) × 0.092 m (lat) × 0.045 m (vert)
    Wheel pos   : right at y=-0.046 z=-0.0052 x=-0.025
                  left  at y=+0.046 z=-0.0052 x=-0.025
    Wheel       : r≈0.029 m, width≈0.011 m
    Caster      : front sphere r=0.010 m
    IR sensors  : right (rds) at (0.028, -0.05, 0.05), left (lds) mirror
    Whiskers    : touch sensors front-right & front-left at ±0.030 m lateral
    Light sens  : rls / lls at ±0.021 m lateral
    LEDs        : right/left at ±0.014 m lateral
-->
<sdf version="1.6">
  <model name="breadboard_hobby_robot">

    <!-- ═══════════════════════════════════════════════════════════
         BASE CHASSIS
         Webots: x=fwd, z=side, y=up.
         Gazebo: x=fwd, y=side, z=up.
         Chassis centre at z=0.029 (wheel r ≈ 0.029 m above ground).
    ═══════════════════════════════════════════════════════════ -->
    <link name="base_link">
      <pose>0 0 0.036 0 0 0</pose>

      <inertial>
        <mass>0.350</mass>
        <inertia>
          <ixx>0.000393</ixx>  <!-- (1/12)*m*(y²+z²) -->
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000519</iyy>
          <iyz>0</iyz>
          <izz>0.000744</izz>
        </inertia>
      </inertial>

      <collision name="chassis_collision">
        <geometry>
          <box>
            <size>0.115 0.092 0.045</size>
          </box>
        </geometry>
      </collision>

      <visual name="chassis_visual">
        <geometry>
          <box>
            <size>0.115 0.092 0.045</size>
          </box>
        </geometry>
        <material>
          <ambient>0.75 0.75 0.78 1</ambient>
          <diffuse>0.70 0.70 0.73 1</diffuse>
          <specular>0.4 0.4 0.4 1</specular>
        </material>
      </visual>

      <!-- Front caster sphere -->
      <collision name="caster_collision">
        <pose>0.057 0 -0.015 0 0 0</pose>
        <geometry>
          <sphere><radius>0.010</radius></sphere>
        </geometry>
        <surface>
          <friction>
            <ode><mu>0</mu><mu2>0</mu2></ode>
          </friction>
        </surface>
      </collision>
      <visual name="caster_visual">
        <pose>0.057 0 -0.015 0 0 0</pose>
        <geometry>
          <sphere><radius>0.010</radius></sphere>
        </geometry>
        <material>
          <ambient>0.6 0.6 0.6 1</ambient>
          <diffuse>0.6 0.6 0.6 1</diffuse>
        </material>
      </visual>

      <!-- ─── IR distance sensors ─────────────────────────────────
           PROTO: rds at (0.028, 0.050, -0.05) in Webots (x,z=-fwd,y=up)
           Gazebo: rds at (x=0.028, y=-0.050, z=0.050) rotated ~67° inward
           lds mirror: (x=-0.028, y=+0.050, z=0.050)
      ──────────────────────────────────────────────────────────── -->
      <sensor name="rds" type="ray">
        <pose>0.028 -0.050 0.050 0 0 -1.170</pose>
        <ray>
          <scan><horizontal><samples>1</samples><min_angle>0</min_angle><max_angle>0</max_angle></horizontal></scan>
          <range><min>0.01</min><max>0.10</max><resolution>0.001</resolution></range>
        </ray>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
      </sensor>

      <sensor name="lds" type="ray">
        <pose>-0.028 0.050 0.050 0 0 1.170</pose>
        <ray>
          <scan><horizontal><samples>1</samples><min_angle>0</min_angle><max_angle>0</max_angle></horizontal></scan>
          <range><min>0.01</min><max>0.10</max><resolution>0.001</resolution></range>
        </ray>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
      </sensor>

      <!-- ─── Whisker touch sensors ──────────────────────────────
           PROTO right_whisker at (0.030, 0.035 h, -0.080 z) → Gazebo y=-0.080
           Modelled as contact/touch sensors via ray proxy (0-length probe).
      ──────────────────────────────────────────────────────────── -->
      <sensor name="right_whisker" type="contact">
        <pose>0.030 -0.080 0.035 0 0 -0.534</pose>
        <contact>
          <collision>right_whisker_collision</collision>
        </contact>
        <always_on>1</always_on>
        <update_rate>20</update_rate>
      </sensor>

      <collision name="right_whisker_collision">
        <pose>0.030 -0.080 0.035 0 0 -0.534</pose>
        <geometry>
          <box><size>0.001 0.001 0.100</size></box>
        </geometry>
      </collision>
      <visual name="right_whisker_visual">
        <pose>0.030 -0.080 0.035 0 0 -0.534</pose>
        <geometry>
          <box><size>0.001 0.001 0.100</size></box>
        </geometry>
        <material>
          <ambient>0.5 0.5 0.5 1</ambient>
          <diffuse>0.5 0.5 0.5 1</diffuse>
        </material>
      </visual>

      <sensor name="left_whisker" type="contact">
        <pose>-0.030 0.080 0.035 0 0 0.534</pose>
        <contact>
          <collision>left_whisker_collision</collision>
        </contact>
        <always_on>1</always_on>
        <update_rate>20</update_rate>
      </sensor>

      <collision name="left_whisker_collision">
        <pose>-0.030 0.080 0.035 0 0 0.534</pose>
        <geometry>
          <box><size>0.001 0.001 0.100</size></box>
        </geometry>
      </collision>
      <visual name="left_whisker_visual">
        <pose>-0.030 0.080 0.035 0 0 0.534</pose>
        <geometry>
          <box><size>0.001 0.001 0.100</size></box>
        </geometry>
        <material>
          <ambient>0.5 0.5 0.5 1</ambient>
          <diffuse>0.5 0.5 0.5 1</diffuse>
        </material>
      </visual>

      <!-- ─── Light sensors (rls / lls) ──────────────────────────
           PROTO: rls at (0.021, 0.052, -0.052) → Gazebo (x=-0.052, y=-0.021, z=0.052)
      ──────────────────────────────────────────────────────────── -->
      <sensor name="rls" type="ray">
        <pose>-0.052 -0.021 0.052 0 0 0</pose>
        <ray>
          <scan><horizontal><samples>1</samples><min_angle>-0.087</min_angle><max_angle>0.087</max_angle></horizontal></scan>
          <range><min>0.01</min><max>2.0</max><resolution>0.01</resolution></range>
        </ray>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
      </sensor>

      <sensor name="lls" type="ray">
        <pose>-0.052 0.021 0.052 0 0 0</pose>
        <ray>
          <scan><horizontal><samples>1</samples><min_angle>-0.087</min_angle><max_angle>0.087</max_angle></horizontal></scan>
          <range><min>0.01</min><max>2.0</max><resolution>0.01</resolution></range>
        </ray>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
      </sensor>

      <!-- ─── LEDs (visual only in SDF; Gazebo light plugin optional) -->
      <visual name="right_led_visual">
        <pose>-0.052 -0.014 0.055 0 0 0</pose>
        <geometry><sphere><radius>0.002</radius></sphere></geometry>
        <material>
          <ambient>0.81 0.21 0.21 1</ambient>
          <diffuse>0.81 0.21 0.21 1</diffuse>
          <emissive>0.81 0.21 0.21 1</emissive>
        </material>
      </visual>

      <visual name="left_led_visual">
        <pose>-0.052 0.014 0.055 0 0 0</pose>
        <geometry><sphere><radius>0.002</radius></sphere></geometry>
        <material>
          <ambient>0.81 0.21 0.21 1</ambient>
          <diffuse>0.81 0.21 0.21 1</diffuse>
          <emissive>0.81 0.21 0.21 1</emissive>
        </material>
      </visual>
    </link>

    <!-- ═══════════════════════════════════════════════════════════
         RIGHT WHEEL  (PROTO: translation 0.046 -0.0052 -0.025)
         Gazebo: x=-0.025 (rear), y=-0.046, z≈0.029 (wheel centre above ground)
    ═══════════════════════════════════════════════════════════ -->
    <link name="right_wheel">
      <pose>-0.025 -0.046 0.029 0 1.5708 1.5708</pose>
      <inertial>
        <mass>0.020</mass>
        <inertia>
          <ixx>0.0000085</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0000085</iyy>
          <iyz>0</iyz>
          <izz>0.0000085</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder><radius>0.029</radius><length>0.011</length></cylinder>
        </geometry>
        <surface>
          <friction>
            <ode><mu>10</mu><mu2>10</mu2></ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder><radius>0.029</radius><length>0.011</length></cylinder>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- ═══════════════════════════════════════════════════════════
         LEFT WHEEL  (PROTO: translation -0.046 -0.0052 -0.025)
         Gazebo: x=-0.025, y=+0.046, z≈0.029
    ═══════════════════════════════════════════════════════════ -->
    <link name="left_wheel">
      <pose>-0.025 0.046 0.029 0 1.5708 1.5708</pose>
      <inertial>
        <mass>0.020</mass>
        <inertia>
          <ixx>0.0000085</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0000085</iyy>
          <iyz>0</iyz>
          <izz>0.0000085</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder><radius>0.029</radius><length>0.011</length></cylinder>
        </geometry>
        <surface>
          <friction>
            <ode><mu>10</mu><mu2>10</mu2></ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder><radius>0.029</radius><length>0.011</length></cylinder>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- ═══════════════════════════════════════════════════════════
         JOINTS
    ═══════════════════════════════════════════════════════════ -->
    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
        <dynamics><friction>0.05</friction><damping>0.05</damping></dynamics>
      </axis>
    </joint>

    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
        <dynamics><friction>0.05</friction><damping>0.05</damping></dynamics>
      </axis>
    </joint>

    <!-- ═══════════════════════════════════════════════════════════
         GAZEBO PLUGINS
    ═══════════════════════════════════════════════════════════ -->
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/breadboard_hobby_robot</namespace>
        <remapping>cmd_vel:=cmd_vel</remapping>
        <remapping>odom:=odom</remapping>
      </ros>
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.092</wheel_separation>
      <wheel_diameter>0.058</wheel_diameter>
      <max_wheel_torque>0.50</max_wheel_torque>
      <max_wheel_acceleration>2.0</max_wheel_acceleration>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
    </plugin>

    <plugin name="joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <namespace>/breadboard_hobby_robot</namespace>
        <remapping>~/out:=joint_states</remapping>
      </ros>
      <update_rate>30</update_rate>
      <joint_name>right_wheel_joint</joint_name>
      <joint_name>left_wheel_joint</joint_name>
    </plugin>

  </model>
</sdf>
