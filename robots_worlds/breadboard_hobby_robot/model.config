<?xml version="1.0"?>

<model>
  <name>Breadboard Hobby Robot</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>

  <author>
    <name>RobotLens Automation Testing</name>
    <email></email>
  </author>

  <description>
    Generic three-wheeled hobby differential-drive robot with a rectangular
    aluminium-style breadboard chassis.
    Dimensions representative of a compact 115 x 92 mm platform:
      Chassis     : box 0.115 m × 0.092 m × 0.045 m
      Wheel sep   : 0.092 m (±0.046 m), wheel r=0.029 m, width=0.011 m
      Caster      : front sphere r=0.010 m
      Sensors     : 2 IR distance sensors, 2 whisker touch sensors,
                    2 light sensors, 2 status LEDs
    Gazebo SDF 1.6 with diff_drive plugin for ROS 2.
  </description>
</model>
