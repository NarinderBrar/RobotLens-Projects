<?xml version="1.0"?>
<sdf version="1.10">
  <!--
    Static RobotLens representation of the PR2 fixture's Gazebo reference table
    and object. Their dimensions and poses mirror grasp_object.py. This file
    is deliberately advertised only by robots_worlds/pr2/scripts/
    scene_description_node.py; it is not a shared example scene.
  -->
  <world name="pr2_reference_objects">
    <model name="graspable_object_table">
      <static>true</static>
      <pose>0.55 -0.35 0.21 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.5 0.4 0.42</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.4 0.42</size></box></geometry>
          <material>
            <ambient>0.55 0.4 0.25 1</ambient>
            <diffuse>0.55 0.4 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="graspable_object">
      <static>true</static>
      <pose>0.55 -0.35 0.445 0 0 0</pose>
      <link name="body">
        <collision name="collision">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material>
            <ambient>0.8 0.15 0.1 1</ambient>
            <diffuse>0.8 0.15 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
