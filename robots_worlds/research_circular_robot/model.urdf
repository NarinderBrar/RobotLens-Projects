<?xml version="1.0"?>
<robot name="rcr">
  <material name="charcoal">
    <color rgba="0.15 0.15 0.18 1.0"/>
  </material>
  <material name="fb_blue">
    <color rgba="0.2 0.3 0.85 1.0"/>
  </material>
  <material name="silver">
    <color rgba="0.75 0.75 0.75 1.0"/>
  </material>

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/firebird6_chassis.obj"/>
      </geometry>
      <material name="charcoal"/>
    </visual>
    <collision>
      <!-- Bottom 1 cm above the floor: only the wheels and caster touch it (a body resting
           on the ground drags, and the robot cannot drive). -->
      <origin xyz="-0.07 0 0.115" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.21" radius="0.162"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="-0.07 0 0.11" rpy="0 0 0"/>
      <mass value="1.40"/>
      <inertia ixx="0.0118" ixy="0" ixz="0" iyy="0.0118" iyz="0" izz="0.0170"/>
    </inertial>
  </link>

  <joint name="wheel_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0.0 0.150 0.045" rpy="-1.5707963 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/firebird6_wheel_left.obj"/>
      </geometry>
      <material name="fb_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.009" radius="0.045"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.08"/>
      <inertia ixx="0.000054" ixy="0" ixz="0" iyy="0.000054" iyz="0" izz="0.000108"/>
    </inertial>
  </link>

  <joint name="wheel_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0.0 -0.150 0.045" rpy="-1.5707963 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/firebird6_wheel_right.obj"/>
      </geometry>
      <material name="fb_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.009" radius="0.045"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.08"/>
      <inertia ixx="0.000054" ixy="0" ixz="0" iyy="0.000054" iyz="0" izz="0.000108"/>
    </inertial>
  </link>

  <joint name="caster_back_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_back"/>
    <origin xyz="-0.210 0.0 0.012" rpy="0 0 0"/>
  </joint>

  <link name="caster_back">
    <visual>
      <geometry>
        <sphere radius="0.012"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.012"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.04"/>
      <inertia ixx="0.000002" ixy="0" ixz="0" iyy="0.000002" iyz="0" izz="0.000002"/>
    </inertial>
  </link>
</robot>
