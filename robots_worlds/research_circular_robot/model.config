<?xml version="1.0"?>

<model>
  <name>Research Circular Robot</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>

  <author>
    <name>RobotLens Automation Testing</name>
    <email></email>
  </author>

  <description>
    Generic large differential-drive research robot with a circular chassis.
    Dimensions representative of a 300 mm diameter circular platform:
      Chassis     : cylinder r=0.156 m, total height ~0.204 m
      Wheel sep   : 0.240 m (±0.120 m), wheel r=0.052 m, width=0.020 m
      Caster      : rear sphere r=0.012 m
      Sensors     : 8 ultrasonic distance sensors (ps0–ps7), IMU
    Gazebo SDF 1.6 with diff_drive plugin for ROS 2.
  </description>
</model>
