<?xml version='1.0'?>
<sdf version='1.9'>
  <model name='warehouse'>
    <pose>0 0 0 0 0 0</pose>
    <self_collide>false</self_collide>
    <!-- BASE_LINK FRAME -->
    <link name='warehouse_base'>
      <pose>0 0 0 0 0 0</pose>
      <!-- A <mesh> collision geometry silently fails to construct under
           gz-sim Harmonic's default dartsim physics engine ("Mesh
           construction from an SDF has not been implemented yet for
           dartsim" -- confirmed via `gz sim --verbose 4`), so the original
           warehouse_colision.stl mesh here produced NO collision at all --
           anything spawned above it fell straight through. Approximated as
           a flat box floor slab instead (visual still uses the full
           warehouse.dae mesh). Footprint (30 x 50) and top-surface height
           (~0.1, matching the mesh's own measured z range and
           drop_area_visual's z=0.101 pose above) taken from
           warehouse_colision.stl's vertex bounding box. -->
      <collision name='warehouse_collision'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>32 52 0.2</size>
          </box>
        </geometry>
      </collision>
      <visual name='warehouse_visual'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>meshes/warehouse.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <visual name="drop_area_visual">
        <pose>0 0 0.101 0 0 0</pose> <!-- x y z R P Y -->
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>meshes/warehouse.dae</uri>
            <submesh>
              <name>drop1</name>
              <center>true</center>
            </submesh>
          </mesh>
        </geometry>
      </visual>
    </link>
    <static>1</static>
  </model>
</sdf>
