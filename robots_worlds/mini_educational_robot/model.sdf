<?xml version="1.0"?>
<!--
  Mini Educational Robot — Gazebo SDF 1.6 model
  Generic miniature two-wheeled differential-drive educational robot.
  Dimensions representative of a small ~75 mm diameter circular platform.

  Physical dimensions (metres):
    Chassis   : cylinder r=0.037 m, h=0.030 m
    Wheel sep : 0.091 m  (left at y=+0.0455, right at y=-0.0455)
    Wheel     : r=0.019 m, width=0.0125 m
    Caster    : sphere r=0.008 m (front passive)
    IR sensors: 8 proximity sensors around perimeter at r~0.040 m
    Line sens : 3 downward-facing at front
-->
<sdf version="1.6">
  <model name="mini_educational_robot">

    <!-- ═══════════════════════════════════════════════════════════
         BASE CHASSIS
    ═══════════════════════════════════════════════════════════ -->
    <link name="base_link">
      <pose>0 0 0.027 0 0 0</pose>

      <inertial>
        <mass>0.175</mass>
        <inertia>
          <ixx>0.000073</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000073</iyy>
          <iyz>0</iyz>
          <izz>0.000120</izz>
        </inertia>
      </inertial>

      <collision name="chassis_collision">
        <geometry>
          <cylinder>
            <radius>0.037</radius>
            <length>0.028</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="chassis_visual">
        <geometry>
          <cylinder>
            <radius>0.037</radius>
            <length>0.028</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.85 0.85 0.85 1</ambient>
          <diffuse>0.80 0.80 0.80 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>

      <!-- Front caster sphere -->
      <collision name="caster_collision">
        <pose>0.030 0 -0.011 0 0 0</pose>
        <geometry>
          <sphere><radius>0.008</radius></sphere>
        </geometry>
        <surface>
          <friction>
            <ode><mu>0</mu><mu2>0</mu2></ode>
          </friction>
        </surface>
      </collision>
      <visual name="caster_visual">
        <pose>0.030 0 -0.011 0 0 0</pose>
        <geometry>
          <sphere><radius>0.008</radius></sphere>
        </geometry>
        <material>
          <ambient>0.4 0.4 0.4 1</ambient>
          <diffuse>0.4 0.4 0.4 1</diffuse>
        </material>
      </visual>

      <!-- ─── IR proximity sensors (ps0–ps7) ───────────────────
           Placed at r=0.040 m around the chassis perimeter.
           Standard educational robot sensor naming convention:
             ps0: front-right  ~-30°
             ps1: right        ~ -90°
             ps2: rear-right   ~-150°
             ps3: rear-left    ~+150°
             ps4: left         ~ +90°
             ps5: front-left   ~+30°
             ps6: front        ~  0°  (ground-facing on real robot — modelled sideways here)
             ps7: front (2nd)  ~  0°
      ──────────────────────────────────────────────────────────── -->
      <sensor name="ps0" type="ray">
        <pose>0.035 -0.020 0 0 0 -0.5236</pose>
        <ray>
          <scan><horizontal><samples>1</samples><min_angle>0</min_angle><max_angle>0</max_angle></horizontal></scan>
          <range><min>0.005</min><max>0.20</max><resolution>0.001</resolution></range>
        </ray>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
      </sensor>

      <sensor name="ps1" type="ray">
        <pose>0 -0.040 0 0 0 -1.5708</pose>
        <ray>
          <scan><horizontal><samples>1</samples><min_angle>0</min_angle><max_angle>0</max_angle></horizontal></scan>
          <range><min>0.005</min><max>0.20</max><resolution>0.001</resolution></range>
        </ray>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
      </sensor>

      <sensor name="ps2" type="ray">
        <pose>-0.035 -0.020 0 0 0 -2.6180</pose>
        <ray>
          <scan><horizontal><samples>1</samples><min_angle>0</min_angle><max_angle>0</max_angle></horizontal></scan>
          <range><min>0.005</min><max>0.20</max><resolution>0.001</resolution></range>
        </ray>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
      </sensor>

      <sensor name="ps3" type="ray">
        <pose>-0.035 0.020 0 0 0 2.6180</pose>
        <ray>
          <scan><horizontal><samples>1</samples><min_angle>0</min_angle><max_angle>0</max_angle></horizontal></scan>
          <range><min>0.005</min><max>0.20</max><resolution>0.001</resolution></range>
        </ray>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
      </sensor>

      <sensor name="ps4" type="ray">
        <pose>0 0.040 0 0 0 1.5708</pose>
        <ray>
          <scan><horizontal><samples>1</samples><min_angle>0</min_angle><max_angle>0</max_angle></horizontal></scan>
          <range><min>0.005</min><max>0.20</max><resolution>0.001</resolution></range>
        </ray>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
      </sensor>

      <sensor name="ps5" type="ray">
        <pose>0.035 0.020 0 0 0 0.5236</pose>
        <ray>
          <scan><horizontal><samples>1</samples><min_angle>0</min_angle><max_angle>0</max_angle></horizontal></scan>
          <range><min>0.005</min><max>0.20</max><resolution>0.001</resolution></range>
        </ray>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
      </sensor>

      <sensor name="ps6" type="ray">
        <pose>0.040 0 0 0 0 0</pose>
        <ray>
          <scan><horizontal><samples>1</samples><min_angle>0</min_angle><max_angle>0</max_angle></horizontal></scan>
          <range><min>0.005</min><max>0.20</max><resolution>0.001</resolution></range>
        </ray>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
      </sensor>

      <sensor name="ps7" type="ray">
        <pose>0.038 0.010 0 0 0 0.2618</pose>
        <ray>
          <scan><horizontal><samples>1</samples><min_angle>0</min_angle><max_angle>0</max_angle></horizontal></scan>
          <range><min>0.005</min><max>0.20</max><resolution>0.001</resolution></range>
        </ray>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
      </sensor>

      <!-- ─── Line sensors (ls0–ls2) — downward facing ────────── -->
      <sensor name="ls0" type="ray">
        <pose>0.030 -0.010 -0.013 0 1.5708 0</pose>
        <ray>
          <scan><horizontal><samples>1</samples><min_angle>0</min_angle><max_angle>0</max_angle></horizontal></scan>
          <range><min>0.001</min><max>0.05</max><resolution>0.001</resolution></range>
        </ray>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
      </sensor>

      <sensor name="ls1" type="ray">
        <pose>0.030 0 -0.013 0 1.5708 0</pose>
        <ray>
          <scan><horizontal><samples>1</samples><min_angle>0</min_angle><max_angle>0</max_angle></horizontal></scan>
          <range><min>0.001</min><max>0.05</max><resolution>0.001</resolution></range>
        </ray>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
      </sensor>

      <sensor name="ls2" type="ray">
        <pose>0.030 0.010 -0.013 0 1.5708 0</pose>
        <ray>
          <scan><horizontal><samples>1</samples><min_angle>0</min_angle><max_angle>0</max_angle></horizontal></scan>
          <range><min>0.001</min><max>0.05</max><resolution>0.001</resolution></range>
        </ray>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
      </sensor>
    </link>

    <!-- ═══════════════════════════════════════════════════════════
         LEFT WHEEL  (y = +0.0455 m, PROTO anchor y=0.0155 + body height ≈ 0.030)
    ═══════════════════════════════════════════════════════════ -->
    <link name="left_wheel">
      <pose>0 0.0455 0.019 0 1.5708 1.5708</pose>
      <inertial>
        <mass>0.010</mass>
        <inertia>
          <ixx>0.0000009</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0000009</iyy>
          <iyz>0</iyz>
          <izz>0.0000018</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder><radius>0.019</radius><length>0.0125</length></cylinder>
        </geometry>
        <surface>
          <friction>
            <ode><mu>10</mu><mu2>10</mu2></ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder><radius>0.019</radius><length>0.0125</length></cylinder>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- ═══════════════════════════════════════════════════════════
         RIGHT WHEEL  (y = -0.0455 m)
    ═══════════════════════════════════════════════════════════ -->
    <link name="right_wheel">
      <pose>0 -0.0455 0.019 0 1.5708 1.5708</pose>
      <inertial>
        <mass>0.010</mass>
        <inertia>
          <ixx>0.0000009</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0000009</iyy>
          <iyz>0</iyz>
          <izz>0.0000018</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder><radius>0.019</radius><length>0.0125</length></cylinder>
        </geometry>
        <surface>
          <friction>
            <ode><mu>10</mu><mu2>10</mu2></ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder><radius>0.019</radius><length>0.0125</length></cylinder>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- ═══════════════════════════════════════════════════════════
         JOINTS
    ═══════════════════════════════════════════════════════════ -->
    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
        <dynamics><friction>0.05</friction><damping>0.05</damping></dynamics>
      </axis>
    </joint>

    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
        <dynamics><friction>0.05</friction><damping>0.05</damping></dynamics>
      </axis>
    </joint>

    <!-- ═══════════════════════════════════════════════════════════
         GAZEBO PLUGINS
    ═══════════════════════════════════════════════════════════ -->
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/mini_educational_robot</namespace>
        <remapping>cmd_vel:=cmd_vel</remapping>
        <remapping>odom:=odom</remapping>
      </ros>
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.091</wheel_separation>
      <wheel_diameter>0.038</wheel_diameter>
      <max_wheel_torque>0.20</max_wheel_torque>
      <max_wheel_acceleration>2.0</max_wheel_acceleration>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
    </plugin>

    <plugin name="joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <namespace>/mini_educational_robot</namespace>
        <remapping>~/out:=joint_states</remapping>
      </ros>
      <update_rate>30</update_rate>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>

  </model>
</sdf>
