<?xml version="1.0"?>

<model>
  <name>Mini Educational Robot</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>

  <author>
    <name>RobotLens Automation Testing</name>
    <email></email>
  </author>

  <description>
    Generic miniature two-wheeled differential-drive educational robot.
    Dimensions representative of a small ~75 mm diameter circular platform:
      Chassis     : cylinder r=0.037 m, h=0.030 m
      Wheel sep   : 0.091 m (±0.0455 m), wheel r=0.019 m, width=0.0125 m
      Caster      : front sphere r=0.008 m
      Sensors     : 8 IR proximity sensors (ps0–ps7), 3 downward line sensors
    Gazebo SDF 1.6 with diff_drive plugin for ROS 2.
  </description>
</model>
