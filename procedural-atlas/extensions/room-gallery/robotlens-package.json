{
  "manifest_version": 1,
  "package_id": "local.room-gallery",
  "version": "0.1.0",
  "host_api_version": 1,
  "contributions": [
    {
      "type": "local.room-gallery/room",
      "kind": "object_generator",
      "module": "modules/room.wasm",
      "run": "on_demand",
      "title": "Room",
      "configuration": {
        "fields": [
          {
            "name": "width",
            "type": "number",
            "label": "Width",
            "unit": "m",
            "min": 1,
            "max": 100,
            "default": 12
          },
          {
            "name": "depth",
            "type": "number",
            "label": "Depth",
            "unit": "m",
            "min": 1,
            "max": 100,
            "default": 8
          },
          {
            "name": "height",
            "type": "number",
            "label": "Wall height",
            "unit": "m",
            "min": 1,
            "max": 10,
            "default": 3
          },
          {
            "name": "wall_thickness",
            "type": "number",
            "label": "Wall thickness",
            "unit": "m",
            "min": 0.05,
            "max": 1,
            "default": 0.15
          },
          {
            "name": "doorway_side",
            "type": "enum",
            "label": "Doorway wall",
            "options": [
              "south",
              "north",
              "east",
              "west",
              "none"
            ],
            "default": "south"
          },
          {
            "name": "doorway_width",
            "type": "number",
            "label": "Doorway width",
            "unit": "m",
            "min": 0.5,
            "max": 10,
            "default": 1.0
          },
          {
            "name": "doorway_height",
            "type": "number",
            "label": "Doorway height",
            "unit": "m",
            "min": 1,
            "max": 5,
            "default": 2.1
          },
          {
            "name": "doorway_offset",
            "type": "number",
            "label": "Doorway offset",
            "unit": "m",
            "min": -50,
            "max": 50,
            "default": 0
          },
          {
            "name": "floor_color",
            "type": "color",
            "label": "Floor color",
            "default": [
              0.55,
              0.55,
              0.52
            ]
          },
          {
            "name": "wall_color",
            "type": "color",
            "label": "Wall color",
            "default": [
              0.86,
              0.85,
              0.8
            ]
          }
        ]
      }
    },
    {
      "type": "local.room-gallery/wall",
      "kind": "object_generator",
      "module": "modules/wall.wasm",
      "run": "on_demand",
      "part": true,
      "title": "Wall",
      "configuration": {
        "fields": [
          {
            "name": "length",
            "type": "number",
            "label": "Length",
            "unit": "m",
            "min": 0.2,
            "max": 100,
            "default": 4
          },
          {
            "name": "height",
            "type": "number",
            "label": "Height",
            "unit": "m",
            "min": 0.2,
            "max": 10,
            "default": 2.5
          },
          {
            "name": "thickness",
            "type": "number",
            "label": "Thickness",
            "unit": "m",
            "min": 0.02,
            "max": 1,
            "default": 0.15
          },
          {
            "name": "x",
            "type": "number",
            "label": "X",
            "unit": "m",
            "min": -100,
            "max": 100,
            "default": 0
          },
          {
            "name": "y",
            "type": "number",
            "label": "Y",
            "unit": "m",
            "min": -100,
            "max": 100,
            "default": 3
          },
          {
            "name": "yaw",
            "type": "number",
            "label": "Yaw",
            "unit": "deg",
            "min": -180,
            "max": 180,
            "default": 0
          },
          {
            "name": "doorway_width",
            "type": "number",
            "label": "Doorway width (0 = none)",
            "unit": "m",
            "min": 0,
            "max": 10,
            "default": 0
          },
          {
            "name": "doorway_height",
            "type": "number",
            "label": "Doorway height",
            "unit": "m",
            "min": 0.5,
            "max": 5,
            "default": 2.1
          },
          {
            "name": "doorway_offset",
            "type": "number",
            "label": "Doorway offset",
            "unit": "m",
            "min": -50,
            "max": 50,
            "default": 0
          },
          {
            "name": "color",
            "type": "color",
            "label": "Color",
            "default": [
              0.86,
              0.85,
              0.8
            ]
          }
        ]
      }
    },
