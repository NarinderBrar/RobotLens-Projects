            "unit": "m",
            "min": 0.01,
            "max": 0.2,
            "default": 0.04
          },
          {
            "name": "leg_thickness",
            "type": "number",
            "label": "Leg thickness",
            "unit": "m",
            "min": 0.01,
            "max": 0.3,
            "default": 0.05
