            "type": "number",
            "label": "Opening width",
            "unit": "m",
            "min": 0.5,
            "max": 5,
            "default": 1.0
          },
          {
            "name": "height",
            "type": "number",
            "label": "Opening height",
            "unit": "m",
            "min": 1,
            "max": 5,
            "default": 2.1
          },
          {
            "name": "frame",
            "type": "number",
            "label": "Frame size",
            "unit": "m",
            "min": 0.02,
            "max": 0.5,
            "default": 0.1
          },
          {
            "name": "depth",
            "type": "number",
            "label": "Frame depth",
            "unit": "m",
            "min": 0.02,
            "max": 1,
            "default": 0.15
          },
          {
            "name": "x",
            "type": "number",
            "label": "X",
            "unit": "m",
            "min": -100,
            "max": 100,
            "default": 0
          },
          {
            "name": "y",
            "type": "number",
            "label": "Y",
            "unit": "m",
            "min": -100,
            "max": 100,
            "default": 3
          },
          {
            "name": "yaw",
            "type": "number",
            "label": "Yaw",
            "unit": "deg",
            "min": -180,
            "max": 180,
            "default": 0
          }
        ]
      }
    },
    {
      "type": "local.room-gallery/table",
      "kind": "object_generator",
      "module": "modules/table.wasm",
      "run": "on_demand",
      "part": true,
