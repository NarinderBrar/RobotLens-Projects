          {
            "name": "cylindrical_legs",
            "type": "boolean",
            "label": "Round legs",
            "default": false
          },
          {
            "name": "bevel",
            "type": "number",
            "label": "Top edge bevel (visual)",
            "unit": "m",
            "min": 0,
            "max": 0.2,
            "default": 0
