    <!-- 5. Rope curtain: 4 ropes pinned at the top bar, hanging free to sway as the robot drives through -->
    <!-- (edge equality="true" -- inextensible, holds its length instead of stretching under a push). -->
    <!-- Bar at 0.30m; ropes lengthened (count 8->10) to hang down to ~0.03m, just clear of the -->
    <!-- floor, instead of stopping at 0.09m -- almost touching the ground now, per request. -->
    <geom name="rope_bar" type="box" size="0.02 0.18 0.02" pos="2.38 0 0.30" rgba="0.3 0.3 0.3 1"/>
    <geom name="rope_post_a" type="box" size="0.02 0.02 0.15" pos="2.38 -0.18 0.15" rgba="0.3 0.3 0.3 1"/>
    <geom name="rope_post_b" type="box" size="0.02 0.02 0.15" pos="2.38 0.18 0.15" rgba="0.3 0.3 0.3 1"/>

    <!-- flexcomp pos is each rope's local-grid *center*, not its pinned end -- with -->
    <!-- count=10/spacing=0.03 the local half-span is 0.135, so pos.z = bar_z - 0.135 -->
    <!-- puts the pinned end (id 0) exactly at the bar (0.30) and the free end at 0.03. -->
    <flexcomp name="rope1" type="grid" dim="1" count="10 1 1" spacing="0.03 0.02 0.02" pos="2.38 -0.15 0.165"
          euler="0 90 0" radius="0.006" mass="0.03" rgba="0.55 0.4 0.2 1">
      <contact condim="3" solref="0.01 1" solimp=".95 .99 .0001"/>
      <edge equality="true" damping="0.3"/>
      <pin id="0"/>
    </flexcomp>
    <flexcomp name="rope2" type="grid" dim="1" count="10 1 1" spacing="0.03 0.02 0.02" pos="2.38 -0.05 0.165"
          euler="0 90 0" radius="0.006" mass="0.03" rgba="0.55 0.4 0.2 1">
      <contact condim="3" solref="0.01 1" solimp=".95 .99 .0001"/>
      <edge equality="true" damping="0.3"/>
      <pin id="0"/>
    </flexcomp>
    <flexcomp name="rope3" type="grid" dim="1" count="10 1 1" spacing="0.03 0.02 0.02" pos="2.38 0.05 0.165"
          euler="0 90 0" radius="0.006" mass="0.03" rgba="0.55 0.4 0.2 1">
      <contact condim="3" solref="0.01 1" solimp=".95 .99 .0001"/>
      <edge equality="true" damping="0.3"/>
      <pin id="0"/>
    </flexcomp>
    <flexcomp name="rope4" type="grid" dim="1" count="10 1 1" spacing="0.03 0.02 0.02" pos="2.38 0.15 0.165"
          euler="0 90 0" radius="0.006" mass="0.03" rgba="0.55 0.4 0.2 1">
      <contact condim="3" solref="0.01 1" solimp=".95 .99 .0001"/>
      <edge equality="true" damping="0.3"/>
      <pin id="0"/>
    </flexcomp>

    <!-- 6. Soft foam obstacle: unpinned spherical soft body resting loose on the floor, -->
    <!-- free to roll/squish under the robot instead of being glued in place. mass=0.4 -->
    <!-- (down from the original 0.5) is a numerically-verified floor for this shape/count -->
    <!-- while unpinned -- swept against the whole scene (not just this body in isolation), -->
    <!-- 0.35 and below reliably diverges within ~1-2s regardless of young/damping/contact -->
    <!-- softness (removing the pin trades the 9-point anchor's stabilizing constraint for -->
    <!-- pure self-elasticity against gravity + contact, which needs more mass to stay stiff -->
    <!-- enough at this timestep). -->
    <flexcomp name="foam" type="ellipsoid" dim="3" count="3 3 3" spacing="0.06 0.06 0.06" pos="2.87 0 0.08"
          radius="0.01" mass="0.4">
      <contact condim="3" solref="0.03 1" solimp=".95 .99 .0001"/>
      <edge equality="false" damping="10"/>
      <elasticity young="100" poisson="0.3"/>
    </flexcomp>

    <!-- 7. Rope horizontal barrier: elastic (not inextensible) tape strung taut between two -->
    <!-- posts, stretches under a push and springs back -- unlike rope1-4 above. -->
    <geom name="barrier_post_a" type="box" size="0.02 0.02 0.15" pos="3.36 -0.4 0.15" rgba="0.3 0.3 0.3 1"/>
    <geom name="barrier_post_b" type="box" size="0.02 0.02 0.15" pos="3.36 0.4 0.15" rgba="0.3 0.3 0.3 1"/>
    <!-- flexcomp pos is the grid's *center*, not vertex 0 -- with count=9/spacing=0.1 the -->
    <!-- half-span is 0.4, matching the posts exactly, so pos.y=0 (their midpoint) puts -->
    <!-- pinned end 0 at y=-0.4 (post_a) and pinned end 8 at y=+0.4 (post_b). Previously -->
    <!-- authored as pos.y=-0.4 (mistaking pos for vertex 0), which put the whole rope -->
    <!-- between y=-0.8 and y=0.0 -- past post_a and short of post_b entirely. -->
    <!-- Mass/length-mechanism/damping now match rope1-4 (inextensible chain, not an -->
    <!-- elastic spring) -- see the physical-properties note this replaced: since count=9/ -->
    <!-- spacing=0.1 gives an unstretched length of exactly 0.8m, the same as the two -->
    <!-- posts' separation, an inextensible chain here has zero slack to sag or yield -->
    <!-- with -- it reads to a robot push as a rigid bar, not tape that stretches and -->
    <!-- springs back. -->
    <flexcomp name="barrier_rope" type="grid" dim="1" count="9 1 1" spacing="0.1 0.02 0.02"
          pos="3.36 0 0.22" euler="0 0 90" radius="0.006" mass="0.03" rgba="1 0.6 0 1">
      <contact condim="3" solref="0.01 1" solimp=".95 .99 .0001"/>
      <edge equality="true" damping="0.3"/>
      <pin id="0 8"/>
    </flexcomp>

    <!-- 8. Ramp: fixed incline the robot can climb, the finale of the obstacle line. -->
    <!-- Lowered further, 8deg/0.14m -> 5deg/0.087m, per request -- low edge stays flush -->
    <!-- with the floor (z=0, physics requires that; it isn't sinking into the ground). -->
    <geom name="ramp" type="box" size="0.5 0.3 0.01" pos="3.99 0 0.0336" euler="0 -5 0"
          rgba="0.55 0.35 0.2 1" friction="0.9 0.02 0.0002"/>

    <!-- 9. Landing platform: flush with the ramp's new, lower high edge (~x=4.49, z=0.087) -->
    <!-- and overlapping it slightly so the robot drives straight from ramp to platform -->
    <!-- instead of off the high edge into open air. -->
    <geom name="ramp_landing" type="box" size="0.3 0.3 0.07" pos="4.77 0 0.017"
          rgba="0.55 0.35 0.2 1" friction="0.9 0.02 0.0002"/>

  </worldbody>

